  <tag k="artist_name" v="В. Г. Ненаживин"/>
  <tag k="description" v="Поэт в скульптурной композиции изображён в длинном плаще наподобие халатов заключённых, у него откинута голова и правая рука поднесена к горлу. Скорбный образ поэта, по мнению Приморской краевой публичной библиотеки им. А.М. Горького отзывает к воспоминан"/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Мандельштам|Осип|Эмильевич||15.1.1891|27.12.1938"/>
  <tag k="material" v="metal"/>
  <tag k="memorial" v="statue"/>
